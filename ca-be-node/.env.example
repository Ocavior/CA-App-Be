# Copy to .env and fill in real values. This mirrors every env var actually
# read anywhere in the ported code (src/config/app.config.js,
# src/config/index.js, src/services/EmailApiService.js) - several of these
# (AZURE_*, gcp_*) are vestigial in the original app too (config surface
# exists, nothing currently reads the values meaningfully) and are kept here
# only for config-surface fidelity. See MIGRATION_NOTES.md.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/ca_app_db

# --- Auth ---
JWT_SECRET=
JWT_EXPIRE=7d
SALT_ROUNDS=10

# --- CORS ---
CORS_ORIGIN=*

# --- Misc app metadata (unused by any current route, preserved for parity) ---
API_VERSION=
APP_NAME=

# --- External services this app calls out to ---
WHATSAPP_API_BASE_URL=https://whatsapp-backend.happyriver-1999a58f.southindia.azurecontainerapps.io/api/whatsapp
EMAIL_SERVICE_URL=
EMAIL_SERVICE_BASE_URL=
EMAIL_USER=
EMAIL_PASSWORD=
APP_CODE=

# --- Vestigial: read into config but not used by any current code path ---
AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_DEPLOYMENT_NAME=
AZURE_API_VERSION=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_ACCESS_KEY=
AZURE_STORAGE_SAS_TOKEN=
gcp_type=
gcp_project_id=
gcp_private_key_id=
gcp_private_key=
gcp_client_email=
gcp_client_id=
gcp_auth_uri=
gcp_token_uri=
gcp_auth_provider_x509_cert_url=
gcp_client_x509_cert_url=
gcp_universe_domain=
