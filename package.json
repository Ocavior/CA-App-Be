{
  "name": "azure-function-app",
  "version": "1.0.0",
  "description": "Advanced Azure Function App with routing and middleware",
  "main": "src/index.js",
  "scripts": {
    "start": "func start",
    "dev": "func start --javascript",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch",
    "test:azure": "cross-env NODE_ENV=test BASE_URL=http://127.0.0.1:7071 jest --runInBand",
    "test:node-server": "cross-env NODE_ENV=test BASE_URL=http://127.0.0.1:3000 jest --runInBand",
    "test:mocks": "node test/mocks/externalServicesServer.js",
    "test:local-mongo": "node test/mocks/startTestMongo.js"
  },
  "dependencies": {
    "@azure/communication-sms": "^1.2.0-beta.3",
    "@azure/functions": "^4.0.0",
    "@azure/storage-blob": "^12.27.0",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.5.0",
    "dots": "^0.1.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^3.1.2",
    "mongodb": "^6.15.0",
    "mongoose": "^8.23.0",
    "mongoose-long": "^0.8.0",
    "nodemailer": "^6.10.0",
    "nodemon": "^3.1.9",
    "parse-multipart": "^1.0.4",
    "path": "^0.12.7",
    "uuid": "^9.0.0",
    "winston": "^3.18.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^8.45.0",
    "jest": "^30.4.2",
